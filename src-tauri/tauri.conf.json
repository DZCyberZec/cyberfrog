{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberFrog",
  "version": "0.12.1",
  "identifier": "com.cyberzec.cyberfrog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CyberFrog",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 Daniele Zecca – CyberZec. Apache License 2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Another SEO Tool"
  }
}
